# video-use-whisper — environment variables
#
# Defaults work out of the box: faster-whisper runs 100% local, no key needed.
# Everything below is optional.

# --- Optional: speaker diarization (pyannote.audio) -----------------------
# Required if you want speaker labels in the transcript. Sign up at
# https://huggingface.co and accept the license at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
# Then create a token at https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# --- Optional: cloud Whisper backend (OpenAI) ----------------------------
# Only needed when running with `--backend openai`.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Optional: backend / model overrides ---------------------------------
# Skip these unless you want to change the defaults globally.
# WHISPER_BACKEND=faster-whisper        # faster-whisper | openai | whisper
# WHISPER_MODEL=large-v3                # tiny | base | small | medium | large-v2 | large-v3
# WHISPER_DEVICE=auto                   # auto | cpu | cuda
# WHISPER_COMPUTE_TYPE=auto             # auto | int8 | int8_float16 | float16 | float32
